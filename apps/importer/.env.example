NODE_ENV=development
LOG_LEVEL=debug
# The same two directories as IMPORT_ARCHIVES_DIR and IMPORT_WORK_DIR in apps/api/.env. The importer only reads the
# first (the API writes the archives there) and only writes the second (the API reads the scans there). In Compose the
# two are the volumes import-archives and import-work; on the host they are folders under .data/import.
IMPORT_ARCHIVES_DIR=../../.data/import/archives
IMPORT_WORK_DIR=../../.data/import/work
